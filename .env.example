# Copy to .env.local (development) or set in your hosting provider's environment settings.

# Public site URL. Only used for canonical links, absolute Open Graph URLs and sitemap.xml
# once VITE_SITE_URL_VERIFIED is "true".
VITE_SITE_URL=https://www.jpandcotech.com

# Set to "true" ONLY after you have confirmed you own the domain and it serves this site.
VITE_SITE_URL_VERIFIED=false

# JSON endpoint that receives contact-form submissions (e.g. a Formspree/Basin form URL or your own API).
# Leave empty to keep the form in "not connected" mode (it opens the visitor's email app instead).
VITE_CONTACT_FORM_ENDPOINT=
